APP_NAME=Image Enhancement API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/image_enhancement

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO

SR_MODEL_VERSION=edsr_x4_baseline
SR_DEVICE=auto
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=CHANGE_ME_IN_ENVIRONMENT
