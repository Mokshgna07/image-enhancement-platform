APP_NAME=Image Enhancement API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://app_user:development_password@localhost:5432/image_enhancement

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO

SR_MODEL_VERSION=edsr_x4_baseline
SR_DEVICE=auto
SR_CONFIG_PATH=ml/configs/training.yaml
SR_CHECKPOINT_4X=runs/edsr_x4_baseline/checkpoints/best.pt
SR_CHECKPOINT_2X=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=CHANGE_ME_IN_ENVIRONMENT

STORAGE_ROOT=storage
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000

REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND_URL=redis://localhost:6379/1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_URL=redis://localhost:6379/2
